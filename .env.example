# Required: Your Discord Bot Token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: Set a specific Discord Server (Guild) ID for instant slash command registration during development.
# Leave blank to sync slash commands globally (global sync can take up to 1 hour to propagate on Discord).
DISCORD_GUILD_ID=

# Optional: Hardware & Concurrency Settings
PREFER_NVENC=true
MAX_CONCURRENT_VIDEO_JOBS=2
MAX_CONCURRENT_IMAGE_JOBS=5
MAX_INPUT_FILE_MB=500
